# Actual Budget server connection
ACTUAL_SERVER_URL=http://localhost:5006
ACTUAL_PASSWORD=change-me
ACTUAL_SYNC_ID=00000000-0000-0000-0000-000000000000
ACTUAL_DATA_DIR=./.actual-cache
# Only needed if the budget file has end-to-end encryption enabled (Settings ->
# Show advanced settings -> End-to-end encryption). This is the file's
# encryption password, separate from ACTUAL_PASSWORD above.
# ACTUAL_E2E_PASSWORD=change-me-encryption

# LocalAI (OpenAI-compatible) connection
LOCALAI_BASE_URL=http://localhost:8080/v1
LOCALAI_MODEL=qwen2.5

# Backend server
PORT=4000
# Shared secret the browser extension must send as `Authorization: Bearer <value>`
SHARED_SECRET=change-me-too

# SQLite file path for the transient order review queue
DB_PATH=./data/orders.sqlite
